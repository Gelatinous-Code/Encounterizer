{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "encounterizer-main",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "encounterizer-preview",
      "database_id": "97796466-8f43-420e-8be6-6df1e83a7dc8",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@encounterizer.com"]
    }
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "APP_ENV": "preview",
    "AUTH_EMAIL_ENABLED": "true",
    "AUTH_ORIGIN": "https://encounterizer-main.dnd-new-dawn-guild-assistant.workers.dev",
    "AUTH_ALLOWED_HOSTS": "encounterizer-main.dnd-new-dawn-guild-assistant.workers.dev,*.encounterizer-main.dnd-new-dawn-guild-assistant.workers.dev",
    "AUTH_TRUSTED_ORIGINS": "https://encounterizer-main.dnd-new-dawn-guild-assistant.workers.dev",
    "TURNSTILE_HOSTNAMES": "encounterizer-main.dnd-new-dawn-guild-assistant.workers.dev"
  },
  "env": {
    "local": {
      "name": "encounterizer-local",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "encounterizer-preview",
          "database_id": "97796466-8f43-420e-8be6-6df1e83a7dc8",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@encounterizer.com"]
        }
      ],
      "limits": {
        "cpu_ms": 30000
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "version_metadata": {
        "binding": "WORKER_VERSION"
      },
      "vars": {
        "APP_ENV": "local",
        "AUTH_EMAIL_ENABLED": "false",
        "AUTH_ORIGIN": "http://localhost:3000",
        "AUTH_ALLOWED_HOSTS": "localhost,127.0.0.1,encounterizer.test",
        "AUTH_TRUSTED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://encounterizer.test",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1,encounterizer.test"
      }
    },
    "staging": {
      "name": "encounterizer-stg",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "encounterizer-stg",
          "database_id": "dc6b3da7-bf4f-4d7f-aad2-beaaf0d2a347",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@encounterizer.com"]
        }
      ],
      "limits": {
        "cpu_ms": 30000
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.05
        }
      },
      "version_metadata": {
        "binding": "WORKER_VERSION"
      },
      "vars": {
        "APP_ENV": "staging",
        "AUTH_EMAIL_ENABLED": "true",
        "AUTH_ORIGIN": "https://encounterizer-stg.dnd-new-dawn-guild-assistant.workers.dev",
        "AUTH_ALLOWED_HOSTS": "encounterizer-stg.dnd-new-dawn-guild-assistant.workers.dev",
        "AUTH_TRUSTED_ORIGINS": "https://encounterizer-stg.dnd-new-dawn-guild-assistant.workers.dev",
        "TURNSTILE_HOSTNAMES": "encounterizer-stg.dnd-new-dawn-guild-assistant.workers.dev"
      }
    },
    "production": {
      "name": "encounterizer-main",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "encounterizer.com",
          "custom_domain": true
        },
        {
          "pattern": "www.encounterizer.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "encounterizer-prod",
          "database_id": "c3b9749e-0c32-48b9-ac43-f51a05ac40c2",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@encounterizer.com"]
        }
      ],
      "limits": {
        "cpu_ms": 30000
      },
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 0.1
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01
        }
      },
      "version_metadata": {
        "binding": "WORKER_VERSION"
      },
      "vars": {
        "APP_ENV": "production",
        "AUTH_EMAIL_ENABLED": "true",
        "AUTH_ORIGIN": "https://encounterizer.com",
        "AUTH_ALLOWED_HOSTS": "encounterizer.com,www.encounterizer.com",
        "AUTH_TRUSTED_ORIGINS": "https://encounterizer.com,https://www.encounterizer.com",
        "TURNSTILE_HOSTNAMES": "encounterizer.com,www.encounterizer.com"
      }
    }
  }
}
