{
  "name": "encounterizer",
  "version": "1.4.0",
  "private": true,
  "description": "Free D&D 5.5e toolkit — encounter prep, live battle tools, and searchable SRD references",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npm run cf:build && opennextjs-cloudflare preview --env local",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy --env=\"\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:d1:migrate:local": "wrangler d1 migrations apply encounterizer-preview --local --env local",
    "cf:d1:migrate:preview": "wrangler d1 migrations apply encounterizer-preview --remote",
    "cf:d1:migrate:staging": "wrangler d1 migrations apply encounterizer-stg --remote --env staging",
    "cf:d1:migrate:production": "wrangler d1 migrations apply encounterizer-prod --remote --env production",
    "cf:d1:pending": "wrangler d1 migrations list encounterizer-stg --remote --env staging",
    "cf:typegen": "wrangler types --env production --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:typegen:check": "wrangler types --env production --env-interface CloudflareEnv cloudflare-env.d.ts --check",
    "cf:test": "wrangler deploy --dry-run --outdir .worker-test --env local && vitest run --config vitest.worker.config.mts",
    "cf:dry-run": "wrangler deploy --dry-run --env staging",
    "cf:startup": "wrangler check startup --env staging",
    "cf:upload:preview": "opennextjs-cloudflare upload --env=\"\"",
    "cf:deploy:staging": "opennextjs-cloudflare deploy --env staging",
    "cf:deploy:production": "opennextjs-cloudflare deploy --env production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline:cloud": "tsx scripts/cloud-baseline.ts",
    "baseline:cloud:check": "tsx scripts/cloud-baseline.ts --check",
    "import:bestiary": "tsx scripts/import-bestiary.ts",
    "import:srd": "tsx scripts/import-srd-content.ts",
    "srd:check": "tsx scripts/srd-md/audit.ts --check",
    "generate:flavor": "tsx scripts/generate-flavor.ts",
    "flavor:check": "tsx scripts/flavor/audit.ts --check",
    "import:spells": "tsx scripts/import-spells.ts",
    "make:runic-font": "node scripts/make-runic-font.mjs",
    "visuals:sync": "tsx scripts/enrich-bestiary-visuals.ts",
    "visuals:check": "tsx scripts/enrich-bestiary-visuals.ts --check",
    "visuals:seed-pilot": "tsx scripts/seed-pilot-visuals.ts",
    "visuals:seed-production": "tsx scripts/seed-production-visuals.ts",
    "visuals:export-review": "tsx scripts/export-visual-review.ts",
    "visuals:audit": "tsx scripts/audit-visual-descriptions.ts",
    "visuals:audit-images": "tsx scripts/audit-monster-images.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Daren9m/Encounterizer.git"
  },
  "homepage": "https://github.com/Daren9m/Encounterizer",
  "bugs": {
    "url": "https://github.com/Daren9m/Encounterizer/issues"
  },
  "keywords": [
    "dnd",
    "5e",
    "encounter",
    "dungeons-and-dragons",
    "tabletop",
    "srd",
    "dm-tools"
  ],
  "author": "Daren9m",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "lucide-react": "^1.24.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.19",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260730.1": true,
    "sharp": false
  }
}
